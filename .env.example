# Supabase: Connect → "Transaction pooler" URI (port 6543) on Netlify, "Session pooler" (port 5432) elsewhere
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"
# Optional: used only for migrations. Supabase "Session pooler" URI (port 5432)
DIRECT_DATABASE_URL=""
# Long random string used to sign admin sessions
AUTH_SECRET="change-me-to-a-long-random-string"
# First admin login, created by `npm run db:seed`
ADMIN_EMAIL="ssgkadatoka@gmail.com"
ADMIN_PASSWORD="change-me"
NEXT_PUBLIC_SITE_URL="https://www.srishivasadgurugoshala.com"
